
entity Booking {
	begin Instant required
    end Instant
    state BookingState required
}

enum BookingState {
    CREATED, USER_VALIDATED,
    APPROVED, CANSELED, COMPLETED
}

entity BookingTable {
	tableName String required
    personCount Integer required
}

entity Place {
	name String required
	workingHours String required
	address String required
}

entity User {
	firstName String required
    middleName String
    lastName String
    birthday Instant
    phone String required 
    email String
    password String
    role UserRole
}


enum UserRole {
    GUEST, ADMIN, MANAGER
}


relationship OneToMany {
	User to Booking{user required}
    Place to BookingTable{place required} 
}


relationship ManyToMany {
	Booking{booking required} to BookingTable{bookingTable required}
}



paginate * with pagination

// Use Data Transfer Objects (DTO)
dto * with mapstruct

// Set service options to all except few
service all with serviceImpl 

// Set an angular suffix
// angularSuffix * with mySuffix
